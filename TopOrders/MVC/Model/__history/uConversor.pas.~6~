unit uConversor;

interface

uses
  System.SysUtils, System.Classes, REST.Types, REST.Client,
   System.JSON, System.Variants,
  Data.Bind.Components, Data.Bind.ObjectScope, Data.DB,
  FireDAC.Comp.Client;

  procedure JsonArrayToFDMemTable(const AJson: string; AMT: TFDMemTable);
  function FDMemTableToJsonArray(AMT: TFDMemTable): string;

implementation


function FDMemTableToJsonArray(AMT: TFDMemTable): string;
(* Modelo de Json =  [
                      {"id":1,"nome":"Ana","ativo":true},
                      {"id":2,"nome":"Beto","ativo":false}
                     ]
**************************************************************)
var
  Arr: TJSONArray;
  Obj: TJSONObject;
  F: TField;

  function FieldToJsonValue(AField: TField): TJSONValue;
  begin
    if AField.IsNull then
      Exit(TJSONNull.Create);

    case AField.DataType of
      ftBoolean:
        if AField.AsBoolean then
          Exit(TJSONTrue.Create)
        else
          Exit(TJSONFalse.Create);

      ftSmallint, ftInteger, ftWord, ftAutoInc, ftLargeint:
        Exit(TJSONNumber.Create(AField.AsLargeInt));

      ftFloat, ftSingle, ftExtended, ftCurrency, ftBCD, ftFMTBcd:
        Exit(TJSONNumber.Create(AField.AsFloat));

      ftDate:
        Exit(TJSONString.Create(FormatDateTime('yyyy-mm-dd', AField.AsDateTime)));

      ftTime:
        Exit(TJSONString.Create(FormatDateTime('hh:nn:ss', AField.AsDateTime)));

      ftDateTime, ftTimeStamp:
        // ISO 8601 básico (sem timezone)
        Exit(TJSONString.Create(FormatDateTime('yyyy-mm-dd"T"hh:nn:ss', AField.AsDateTime)));

    else
      // string e qualquer outro tipo vira string
      Exit(TJSONString.Create(AField.AsString));
    end;
  end;

begin
  Arr := TJSONArray.Create;
  try
    if AMT.Active then
    begin
      AMT.DisableControls;
      try
        AMT.First;
        while not AMT.Eof do
        begin
          Obj := TJSONObject.Create;
          for F in AMT.Fields do
            Obj.AddPair(F.FieldName, FieldToJsonValue(F));

          Arr.AddElement(Obj);
          AMT.Next;
        end;
      finally
        AMT.EnableControls;
      end;
    end;

    Result := Arr.ToJSON;
  finally
    Arr.Free;
  end;
end;

procedure JsonArrayToFDMemTable(const AJson: string; AMT: TFDMemTable);
(* Modelo de Json =  [
                      {"id":1,"nome":"Ana","ativo":true},
                      {"id":2,"nome":"Beto","ativo":false}
                     ]
**************************************************************)
var
  Arr: TJSONArray;
  Obj: TJSONObject;
  Pair: TJSONPair;
  i: Integer;

  function GuessFieldType(V: TJSONValue): TFieldType;
  var
    s: string;
  begin
    if (V = nil) or (V is TJSONNull) then Exit(ftString);

    if V is TJSONNumber then
    begin
      s := TJSONNumber(V).ToString;
      if Pos('.', s) > 0 then Exit(ftFloat) else Exit(ftLargeint);
    end;

    if (V is TJSONTrue) or (V is TJSONFalse) then Exit(ftBoolean);

    // data normalmente vem como string, então fica string mesmo (você converte depois)
    Exit(ftString);
  end;

  function JsonValueToVariant(V: TJSONValue): Variant;
  var
    s: string;
    i64: Int64;
    d: Double;
  begin
    if (V = nil) or (V is TJSONNull) then Exit(Null);

    if V is TJSONString then Exit(TJSONString(V).Value);

    if V is TJSONNumber then
    begin
      s := TJSONNumber(V).ToString;
      if TryStrToInt64(s, i64) then Exit(i64);

      // decimal do JSON é "."
      s := StringReplace(s, '.', FormatSettings.DecimalSeparator, []);
      if TryStrToFloat(s, d) then Exit(d);

      Exit(s);
    end;

    if V is TJSONTrue then Exit(True);
    if V is TJSONFalse then Exit(False);

    // objeto/array dentro -> salva como texto
    Exit(V.ToJSON);
  end;

begin
  Arr := TJSONObject.ParseJSONValue(AJson) as TJSONArray;
  if Arr = nil then
    raise Exception.Create('JSON inválido ou não é um array.');

  try
    AMT.DisableControls;
    try
      AMT.Close;
      AMT.FieldDefs.Clear;

      if Arr.Count = 0 then
      begin
        AMT.CreateDataSet;
        Exit;
      end;

      Obj := Arr.Items[0] as TJSONObject;
      if Obj = nil then
        raise Exception.Create('Array não contém objetos.');

      // cria campos baseado no 1º item
      for Pair in Obj do
        AMT.FieldDefs.Add(Pair.JsonString.Value, GuessFieldType(Pair.JsonValue), 0);

      AMT.CreateDataSet;

      // popula
      for i := 0 to Arr.Count - 1 do
      begin
        Obj := Arr.Items[i] as TJSONObject;
        if Obj = nil then Continue;

        AMT.Append;
        for Pair in Obj do
          if AMT.FindField(Pair.JsonString.Value) <> nil then
            AMT.FieldByName(Pair.JsonString.Value).Value := JsonValueToVariant(Pair.JsonValue);
        AMT.Post;
      end;

    finally
      AMT.EnableControls;
    end;
  finally
    Arr.Free;
  end;
end;


end.
